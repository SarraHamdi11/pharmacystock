# 🚀 Production Environment Variables - PharmaStock Pro

APP_NAME="PharmaStock Pro"
APP_ENV=production
APP_KEY=base64:GENERATE_THIS_VIA_ARTISAN
APP_DEBUG=false
APP_URL=https://your-production-domain.com

# Database (MySQL/PostgreSQL recommended for production)
DB_CONNECTION=mysql
DB_HOST=your-database-host
DB_PORT=3306
DB_DATABASE=pharmastock_prod
DB_USERNAME=your-username
DB_PASSWORD=your-password

# Session & Cache (Database driver recommended for horizontal scaling)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=error

# Mail (Use a real provider like Mailgun, Postmark, or SendGrid)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Security
SESSION_DOMAIN=your-production-domain.com
SANCTUM_STATEFUL_DOMAINS=your-production-domain.com

# Optimization
DEBUGBAR_ENABLED=false
